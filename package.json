{
  "name": "sdk-ci",
  "version": "0.0.0",
  "private": true,
  "description": "Shared CI and release steps for the @hussmartinez SDK family, as GitHub composite actions.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "biome check .",
    "release:check": "node scripts/release.mjs --check",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm release:check && pnpm test",
    "verify:fast": "pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@hussmartinez/sdk-config": "^0.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "secretlint": "^13.1.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
